"""
Weeks 2-3 (continued) - Mortgage Rate Enrichment

Fetches the FRED MORTGAGE30US series, resamples weekly rates to monthly
averages, merges them onto the combined sold and listings datasets using a
year_month key, validates that no rate values are null, and saves both
enriched datasets as new CSVs.
"""

from pathlib import Path
import pandas as pd

# --- Settings ---------------------------------------------------------------
DATA_DIR = Path(r"C:/Users/makay/OneDrive/Documents/IDX Internship/new csv/week 2, 3")   # folder holding the combined CSVs

SOLD_FILE = "sold_residential_filtered.csv"
LISTINGS_FILE = "listings_residential_filtered.csv"

url = "https://fred.stlouisfed.org/graph/fredgraph.csv?id=MORTGAGE30US"

pd.set_option("display.width", 200)


# ============================================================================
# STEP 1 - Fetch the mortgage rate data from FRED
# ============================================================================
print("Fetching MORTGAGE30US from FRED...")
mortgage = pd.read_csv(url)

mortgage = pd.read_csv(url, parse_dates=['observation_date'])
mortgage.columns = ['date', 'rate_30yr_fixed']

print(f"  {len(mortgage):,} weekly observations, "
      f"{mortgage['date'].min().date()} to {mortgage['date'].max().date()}")


# ============================================================================
# STEP 2 - Resample weekly rates to monthly averages
# ============================================================================
mortgage["year_month"] = mortgage["date"].dt.to_period("M")

mortgage_monthly = (
    mortgage.groupby("year_month")["rate_30yr_fixed"]
    .mean()
    .round(4)
    .reset_index()
)

print(f"  resampled to {len(mortgage_monthly):,} monthly averages")
print("\nMonthly rates over the MLS period (2024-01 onward):")
print(mortgage_monthly[mortgage_monthly["year_month"] >=
                       pd.Period("2024-01", freq="M")].to_string(index=False))


# ============================================================================
# STEPS 3-5 - Key, merge, validate
# ============================================================================
def enrich(filename, date_col, label, outfile):
    print(f"\n{'=' * 70}\n{label.upper()}\n{'=' * 70}")

    df = pd.read_csv(DATA_DIR / filename, low_memory=False)
    print(f"Rows: {len(df):,}")

    # STEP 3 - matching year_month key from the transaction date
    df["year_month"] = pd.to_datetime(df[date_col], errors="coerce").dt.to_period("M")

    missing_dates = df["year_month"].isna().sum()
    if missing_dates:
        print(f"  WARNING: {missing_dates:,} rows have no usable {date_col}")

    # STEP 4 - left merge, so no MLS rows are lost
    rows_before = len(df)
    merged = df.merge(mortgage_monthly, on="year_month", how="left")

    # A left merge must not change the row count. If it does, the right-hand
    # table had duplicate keys - which would silently multiply rows.
    assert len(merged) == rows_before, "Row count changed during merge!"
    print(f"  rows before merge: {rows_before:,}   after merge: {len(merged):,}")

    # STEP 5 - validation: no null rates after the merge
    nulls = merged["rate_30yr_fixed"].isnull().sum()
    print(f"\n  VALIDATION - null rate_30yr_fixed values: {nulls:,}")

    if nulls == 0:
        print("  PASS: every row matched a monthly rate.")
    else:
        # Say *why* rows failed to match, rather than just that they did.
        print("  FAIL: investigating unmatched rows...")
        unmatched = merged[merged["rate_30yr_fixed"].isnull()]
        no_date = unmatched["year_month"].isna().sum()
        bad_month = unmatched[unmatched["year_month"].notna()]

        print(f"    {no_date:,} rows have a missing/unparseable {date_col}")
        if len(bad_month):
            print(f"    {len(bad_month):,} rows have a month with no FRED rate:")
            print(bad_month["year_month"].value_counts().sort_index().to_string())

    # Preview
    cols = [date_col, "year_month", "rate_30yr_fixed"]
    if "ClosePrice" in merged.columns:
        cols.insert(2, "ClosePrice")
    print("\n  Preview:")
    print(merged[cols].head().to_string(index=False))

    merged.to_csv(DATA_DIR / outfile, index=False)
    print(f"\n  Saved: {outfile}  ({len(merged):,} rows x {merged.shape[1]} columns)")

    return merged


sold_with_rates = enrich(
    SOLD_FILE, "CloseDate", "Sold", "sold_with_rates.csv"
)

listings_with_rates = enrich(
    LISTINGS_FILE, "ListingContractDate", "Listings", "listings_with_rates.csv"
)

print("\nDone.")
