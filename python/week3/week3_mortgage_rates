"""
Weeks 2-3 (continued) - Mortgage Rate Enrichment

Fetches the FRED MORTGAGE30US series, resamples it to monthly averages,
merges it onto the combined sold and listings datasets using a year_month
key, validates that no rate values are null, and saves both enriched
datasets as new CSVs.
"""

import pandas as pd

# Folder holding the combined CSVs, and where the enriched ones are saved
DATA_DIR = r"C:/Users/makay/OneDrive/Documents/IDX Internship/new csv/week 2, 3"

# Load the combined datasets
sold = pd.read_csv(DATA_DIR + r"\sold_residential_filtered.csv", low_memory=False)
listings = pd.read_csv(DATA_DIR + r"\listings_residential_filtered.csv", low_memory=False)


# Step 1 - Fetch the mortgage rate data from FRED
url = "https://fred.stlouisfed.org/graph/fredgraph.csv?id=MORTGAGE30US"
mortgage = pd.read_csv(url, parse_dates=['observation_date'])
mortgage.columns = ['date', 'rate_30yr_fixed']


# Step 2 - Resample weekly rates to monthly averages
mortgage['year_month'] = mortgage['date'].dt.to_period('M')
mortgage_monthly = (
    mortgage.groupby('year_month')['rate_30yr_fixed']
    .mean()
    .reset_index()
)


# Step 3 - Create a matching year_month key on the MLS datasets

# Sold dataset - key off CloseDate
sold['year_month'] = pd.to_datetime(sold['CloseDate']).dt.to_period('M')

# Listings dataset - key off ListingContractDate
listings['year_month'] = pd.to_datetime(
    listings['ListingContractDate']
).dt.to_period('M')


# Step 4 - Merge
sold_with_rates = sold.merge(mortgage_monthly, on='year_month', how='left')
listings_with_rates = listings.merge(mortgage_monthly, on='year_month', how='left')


# Step 5 - Validate the merge

# Check for any unmatched rows (rate should not be null)
print("Null rates in sold:", sold_with_rates['rate_30yr_fixed'].isnull().sum())
print("Null rates in listings:", listings_with_rates['rate_30yr_fixed'].isnull().sum())

# Preview
print(
    sold_with_rates[
        ['CloseDate', 'year_month', 'ClosePrice', 'rate_30yr_fixed']
    ].head()
)


# Step 6 - Save the enriched datasets
sold_with_rates.to_csv(DATA_DIR + r"\sold_with_rates.csv", index=False)
listings_with_rates.to_csv(DATA_DIR + r"\listings_with_rates.csv", index=False)

print("Saved sold_with_rates.csv and listings_with_rates.csv")
